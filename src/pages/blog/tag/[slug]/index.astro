---
import PostCard from "@/components/PostCard.astro";
import BookControlPanel from "@/components/widget/ControlPanel/BookControlPanel.astro";
import { tagsList } from "@/data/blog/tags";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getBooks } from "@/scripts/library/microcms";
import { getTagList } from "@/utils/content-utils";

interface Props {
  name: string;
  slug: string;
}

export async function getStaticPaths() {
  return tagsList.map(tag => {
    const { name, slug } = tag;
    return {
      params: { slug },
      props: { name, slug }
    }
  })
}

const { name, slug } = Astro.props;
const blogs = await getTagList(name);
const books = await getBooks();
---

<MainGridLayout
  pageTitle={name}
  description={`${name}タグの記事一覧`}
>

  <div class="grid">
    {blogs.map((post) => (
      <PostCard post={post} />
    ))}
  </div>

  <BookControlPanel
    title="読んだ本リスト"
    books={books.slice(0, 10)}
    link="/book/"
  />

</MainGridLayout>

<style lang="scss">
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18.5rem, 1fr));

    @include mixin.phone {
      grid-template-columns: 1fr;
    }
  }
</style>